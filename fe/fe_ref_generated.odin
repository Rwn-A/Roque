//== Basis evaluation

@(private)
ref_point_lagrange_o0_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 1)
	d := out.data
	d[0] = 1
}

@(private)
ref_point_lagrange_o1_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 1)
	d := out.data
	d[0] = 1
}

@(private)
ref_point_lagrange_o2_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 1)
	d := out.data
	d[0] = 1
}

@(private)
ref_point_lagrange_o3_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 1)
	d := out.data
	d[0] = 1
}

@(private)
ref_line_lagrange_o0_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 1)
	d := out.data
	d[0] = 1
}

@(private)
ref_line_lagrange_o0_s_grd :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 1)
	d := out.data
	d[0] = 0
}

@(private)
ref_line_lagrange_o1_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 2 && out.cmpnts == 1)
	x := r[0]
	d := out.data
	d[0] = 0.5 - 0.5*x
	d[1] = 0.5 + 0.5*x
}

@(private)
ref_line_lagrange_o1_s_grd :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 2 && out.cmpnts == 1)
	d := out.data
	d[0] = -0.5
	d[1] = 0.5
}

@(private)
ref_line_lagrange_o2_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 3 && out.cmpnts == 1)
	x := r[0]
	x2 := x*x
	d := out.data
	d[0] = -0.5*x + 0.5*x2
	d[1] = 0.5*x + 0.5*x2
	d[2] = 1 - x2
}

@(private)
ref_line_lagrange_o2_s_grd :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 3 && out.cmpnts == 1)
	x := r[0]
	d := out.data
	d[0] = -0.5 + x
	d[1] = 0.5 + x
	d[2] = -2*x
}

@(private)
ref_line_lagrange_o3_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 4 && out.cmpnts == 1)
	x := r[0]
	x2 := x*x
	x3 := x2*x
	d := out.data
	d[0] = -0.0625 + 0.0625*x + 0.5625*x2 - 0.5625*x3
	d[1] = -0.0625 - 0.0625*x + 0.5625*x2 + 0.5625*x3
	d[2] = 0.5625 - 1.6875*x - 0.5625*x2 + 1.6875*x3
	d[3] = 0.5625 + 1.6875*x - 0.5625*x2 - 1.6875*x3
}

@(private)
ref_line_lagrange_o3_s_grd :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 4 && out.cmpnts == 1)
	x := r[0]
	x2 := x*x
	d := out.data
	d[0] = 0.0625 + 1.125*x - 1.6875*x2
	d[1] = -0.0625 + 1.125*x + 1.6875*x2
	d[2] = -1.6875 - 1.125*x + 5.0625*x2
	d[3] = 1.6875 - 1.125*x - 5.0625*x2
}

@(private)
ref_tri_lagrange_o0_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 1)
	d := out.data
	d[0] = 1
}

@(private)
ref_tri_lagrange_o0_s_grd :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 2)
	d := out.data
	d[0] = 0
	d[1] = 0
}

@(private)
ref_tri_lagrange_o1_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 3 && out.cmpnts == 1)
	x, y := r[0], r[1]
	d := out.data
	d[0] = 1 - x - y
	d[1] = x
	d[2] = y
}

@(private)
ref_tri_lagrange_o1_s_grd :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 3 && out.cmpnts == 2)
