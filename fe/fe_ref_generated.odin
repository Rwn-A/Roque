@(private)
ref_hex_lagrange_o0_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 1)
	d := out.data
	d[0] = 1
}

@(private)
ref_hex_lagrange_o0_s_grd :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 1 && out.cmpnts == 3)
	d := out.data
	d[0] = 0
	d[1] = 0
	d[2] = 0
}

@(private)
ref_hex_lagrange_o1_s_val :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 8 && out.cmpnts == 1)
	x, y, z := r[0], r[1], r[2]
	d := out.data
	d[0] = 0.125 - 0.125*x - 0.125*y - 0.125*z + 0.125*x*y + 0.125*x*z + 0.125*y*z - 0.125*x*y*z
	d[1] = 0.125 + 0.125*x - 0.125*y - 0.125*z - 0.125*x*y - 0.125*x*z + 0.125*y*z + 0.125*x*y*z
	d[2] = 0.125 - 0.125*x + 0.125*y - 0.125*z - 0.125*x*y + 0.125*x*z - 0.125*y*z + 0.125*x*y*z
	d[3] = 0.125 + 0.125*x + 0.125*y - 0.125*z + 0.125*x*y - 0.125*x*z - 0.125*y*z - 0.125*x*y*z
	d[4] = 0.125 - 0.125*x - 0.125*y + 0.125*z + 0.125*x*y - 0.125*x*z - 0.125*y*z + 0.125*x*y*z
	d[5] = 0.125 + 0.125*x - 0.125*y + 0.125*z - 0.125*x*y + 0.125*x*z - 0.125*y*z - 0.125*x*y*z
	d[6] = 0.125 - 0.125*x + 0.125*y + 0.125*z - 0.125*x*y - 0.125*x*z + 0.125*y*z - 0.125*x*y*z
	d[7] = 0.125 + 0.125*x + 0.125*y + 0.125*z + 0.125*x*y + 0.125*x*z + 0.125*y*z + 0.125*x*y*z
}

@(private)
ref_hex_lagrange_o1_s_grd :: proc(r: Ref_Vec, out: Bvec_Point(f64)) {
	assert(out.dofs == 8 && out.cmpnts == 3)
	x, y, z := r[0], r[1], r[2]
	d := out.data
	d[0] = -0.125 + 0.125*y + 0.125*z - 0.125*y*z
	d[1] = -0.125 + 0.125*x + 0.125*z - 0.125*x*z
	d[2] = -0.125 + 0.125*x + 0.125*y - 0.125*x*y
	d[3] = 0.125 - 0.125*y - 0.125*z + 0.125*y*z
	d[4] = -0.125 - 0.125*x + 0.125*z + 0.125*x*z
